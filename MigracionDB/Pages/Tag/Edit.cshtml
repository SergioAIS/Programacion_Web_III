@page
@model MigracionDB.Pages.Tag.EditModel
@{
}
<h1> Editar Tags</h1>
<form method="post">
	<div class="mb-3">
		<input type="hidden" asp-for="Tag.Id" />
		<label asp-for="Tag.Name">Nombre</label>
		<input asp-for="Tag.Name" class="form-control" />
	</div>
	<button type="submit" class="btn btn-primary">Guardar</button>
	<a asp-page="Index" class="btn btn-secondary">Volver</a>
</form>
