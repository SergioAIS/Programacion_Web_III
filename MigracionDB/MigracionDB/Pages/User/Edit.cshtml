@page
@model MigracionDB.Pages.User.EditModel
@{
}
<h1> Editar Users</h1>
<form method="post">
	<div class="mb-3">
		<input type="hidden" asp-for="User.Id" />
		<label asp-for="User.Name">Nombre</label>
		<input asp-for="User.Name" class="form-control" />
	</div>
	<div>
		<label asp-for="User.LastName">Apellido</label>
		<input asp-for="User.LastName" class="form-control" />
		<div>
			<label asp-for="User.Email">Email</label>
			<input asp-for="User.Email" class="form-control" />
		</div>
		<div>
			<label asp-for="User.Password">Contraseña</label>
			<input asp-for="User.Password" class="form-control" />
		</div>
		<div>
			<label asp-for="User.UserName">Nombre de Usuario</label>
			<input asp-for="User.UserName" class="form-control" />
		</div>
	<button type="submit" class="btn btn-primary">Guardar</button>
	<a asp-page="Index" class="btn btn-secondary">Volver</a>
</form>
