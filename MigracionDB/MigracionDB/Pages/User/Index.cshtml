@page 
@model MigracionDB.Pages.User.IndexModel
@{
}
<h1> Usuarios </h1>
<p><a asp-page="Create" class="btn btn-primary">Crear</a></p>
<table>
	<thead>
	<th>ID</th>
	<th> Nombre</th>
	<th> Apellido</th>
	<th> Email</th>
	<th> Contraseña</th>
	<th> NOmbre de Usuario</th>
	</thead>
	<tbody>

		@foreach (var user in Model.Useres)
		{
			<tr>
				<td>@user.Id</td>
				<td>@user.Name</td>
				<td>@user.LastName</td>
				<td>@user.Email</td>
				<td>@user.Password</td>
				<td>@user.UserName</td>
				<td><a asp-page="Edit" asp-route-id="@user.Id" class="btn btn-info">Editar</a></td>
				<td><a asp-page="Delete" asp-route-id="@user.Id" class="btn btn-danger">Borrar</a></td>


			</tr>
		}
	</tbody>
</table>