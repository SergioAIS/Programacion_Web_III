@page
@model ActAsíncrona1Web3.Pages.ContactoModel
@{
    ViewData["Title"] = "Contacto";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <h1 class="display-4 text-center mb-4">Contáctanos</h1>
            <p class="lead text-center mb-5">¿Tienes alguna pregunta? Estamos aquí para ayudarte</p>
            
            <div class="row">
                <div class="col-md-8">
                    <div class="card shadow-sm">
                        <div class="card-body p-4">
                            <h5 class="card-title mb-4">
                                <i class="bi bi-envelope me-2 text-primary"></i>Envíanos un mensaje
                            </h5>
                            
                            <form method="post">
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label for="nombre" class="form-label">Nombre completo</label>
                                        <input type="text" class="form-control" id="nombre" name="Nombre" value="@Model.Nombre" required>
                                    </div>
                                    
                                    <div class="col-md-6 mb-3">
                                        <label for="email" class="form-label">Email</label>
                                        <input type="email" class="form-control" id="email" name="Email" value="@Model.Email" required>
                                    </div>
                                </div>
                                
                                <div class="mb-3">
                                    <label for="asunto" class="form-label">Asunto</label>
                                    <input type="text" class="form-control" id="asunto" name="Asunto" value="@Model.Asunto" required>
                                </div>
                                
                                <div class="mb-4">
                                    <label for="mensaje" class="form-label">Mensaje</label>
                                    <textarea class="form-control" id="mensaje" name="Mensaje" rows="5" required>@Model.Mensaje</textarea>
                                </div>
                                
                                <div class="text-center">
                                    <button type="submit" class="btn btn-primary btn-lg px-5">
                                        <i class="bi bi-send me-2"></i>Enviar Mensaje
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-4">
                    <div class="card bg-light border-0">
                        <div class="card-body p-4">
                            <h5 class="card-title mb-4">
                                <i class="bi bi-info-circle me-2 text-primary"></i>Información de Contacto
                            </h5>
                            
                            <div class="mb-4">
                                <h6 class="fw-bold">TechUniv</h6>
                                <p class="text-muted mb-0">Universidad Tecnológica de Innovación y Futuro Digital</p>
                            </div>
                            
                            <div class="mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-geo-alt text-primary me-3"></i>
                                    <div>
                                        <strong>Dirección</strong><br>
                                        <span class="text-muted">Calle Tecnología 123<br>Madrid, España</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-telephone text-primary me-3"></i>
                                    <div>
                                        <strong>Teléfono</strong><br>
                                        <span class="text-muted">+34 91 123 45 67</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-envelope text-primary me-3"></i>
                                    <div>
                                        <strong>Email</strong><br>
                                        <span class="text-muted">info@techuniv.es</span>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="mb-3">
                                <div class="d-flex align-items-center mb-2">
                                    <i class="bi bi-clock text-primary me-3"></i>
                                    <div>
                                        <strong>Horario</strong><br>
                                        <span class="text-muted">Lunes a Viernes<br>8:00 - 18:00</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
